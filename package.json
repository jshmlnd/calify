{
  "name": "calify",
  "version": "1.1.2",
  "description": "Calify music player",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win nsis",
    "android:sync": "vite build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "release": "node scripts/release.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capgo/capacitor-media-session": "^8.1.11",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "electron-updater": "^6.8.11",
    "idb-keyval": "^6.3.0",
    "music-metadata": "^12.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "productName": "Calify",
  "author": "Calify",
  "build": {
    "appId": "com.calify.app",
    "productName": "Calify",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!node_modules/@capacitor/**",
      "!node_modules/@capgo/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Calify"
    },
    "protocols": [
      {
        "name": "Calify",
        "schemes": [
          "calify"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "jshmlnd",
        "repo": "calify"
      }
    ]
  }
}
