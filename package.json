{
  "name": "calify",
  "version": "1.0.0",
  "description": "Calify music player",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win nsis",
    "android:sync": "vite build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "type": "module",
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "https://github.com/castlabs/electron-releases/archive/refs/tags/v45.2.1%2Bwvcus.tar.gz",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capgo/capacitor-media-session": "^8.1.11",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "music-metadata": "^12.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "productName": "Calify",
  "author": "Calify",
  "build": {
    "appId": "com.calify.app",
    "productName": "Calify",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Calify"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterSign": "build/evs-sign.cjs"
  }
}
